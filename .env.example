# Optional server-only key for higher Credits.fm rate limits.
# Never expose this value through VITE_* variables or commit a real .env file.
CREDITS_FM_API_KEY=

# Browser-safe Supabase project values. Row Level Security protects each user's data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional comma-separated allowlist for the private research API.
# Example: ALLOWED_USER_EMAILS=friend@example.com,owner@example.com
ALLOWED_USER_EMAILS=
